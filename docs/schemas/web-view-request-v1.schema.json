        "scope": {
          "default": {
            "allTime": null,
            "timezone": null,
            "since": null,
            "until": null,
            "agentKind": null,
            "sourceInstanceId": null,
            "model": null,
            "modelUnknown": null,
            "effortUnknown": null,
            "undated": null,
            "reasoningEffort": null,
            "project": null,
            "projectUnknown": null,
            "threadId": null,
            "turnId": null
