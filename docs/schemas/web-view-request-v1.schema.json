        "effortUnknown": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "undated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reasoningEffort": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "projectUnknown": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "turnId": {
          "description": "Exact turn inspection, always bound to a selected thread.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
