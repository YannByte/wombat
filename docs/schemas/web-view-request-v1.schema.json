  "definitions": {
    "Page": {
      "type": "string",
      "enum": [
        "usage",
        "threads",
        "instructions",
        "extensions",
        "optimize"
      ]
    },
    "Request": {
      "type": "object",
      "properties": {
        "comparison": {
          "anyOf": [
            {
              "$ref": "#/definitions/ComparisonRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "action": {
          "$ref": "#/definitions/Action"
        },
        "snapshotId": {
          "type": [
            "string",
            "null"
          ]
        },
        "roots": {
          "type": [
            "array",
            "null"
          ],
          "items": {
