{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Request",
  "type": "object",
  "properties": {
    "page": {
      "$ref": "#/definitions/Page"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/definitions/Request"
        },
        {
          "type": "null"
        }
      ]
    },
    "configuration": {
      "anyOf": [
        {
          "$ref": "#/definitions/Request2"
        },
        {
          "type": "null"
        }
      ]
    },
    "optimization": {
      "anyOf": [
