            "boolean",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "action"
      ]
    },
    "ComparisonRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "baselineSince": {
              "type": "string"
            },
            "baselineUntil": {
              "type": "string"
            },
            "dimension": {
              "$ref": "#/definitions/DriverDimension"
            },
            "kind": {
              "type": "string",
              "const": "periods"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "baselineSince",
            "baselineUntil",
            "dimension"
          ]
        },
        {
          "type": "object",
          "properties": {
            "leftThreadId": {
              "type": "string"
            },
            "rightThreadId": {
              "type": "string"
            },
            "includeDescendants": {
              "type": "boolean",
              "default": false
            },
            "kind": {
              "type": "string",
              "const": "sessions"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "leftThreadId",
            "rightThreadId"
          ]
        }
      ]
