              "$ref": "#/definitions/Category"
            },
            {
              "type": "null"
            }
          ]
        },
        "offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
