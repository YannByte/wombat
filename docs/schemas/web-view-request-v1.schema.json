        "sort": {
          "default": "tokens",
          "allOf": [
            {
              "$ref": "#/definitions/Sort2"
            }
          ]
        },
        "itemId": {
          "type": [
            "string",
            "null"
          ]
        },
        "offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
