    "Action": {
      "type": "string",
      "enum": [
        "refresh",
        "usage",
        "threads",
        "turns",
        "steps",
        "compare",
        "investigate",
        "trajectory",
        "resources",
        "review",
        "context",
        "statistics"
      ]
