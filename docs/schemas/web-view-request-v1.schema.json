            },
            {
              "type": "null"
            }
          ]
        },
        "kinds": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/definitions/Kind"
          }
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/definitions/Observation"
            },
            {
              "type": "null"
            }
