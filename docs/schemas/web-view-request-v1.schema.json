    "ActivitySelection": {
      "description": "Fixed turn analysis, separate from configuration identities and durable handling decisions.",
      "type": "object",
      "properties": {
        "snapshotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "threadId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "turnId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "additionalProperties": false,
      "required": [
        "snapshotId",
        "threadId",
        "turnId"
      ]
    }
