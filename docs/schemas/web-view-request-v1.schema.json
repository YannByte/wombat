          "anyOf": [
            {
              "$ref": "#/definitions/Presentation"
            },
            {
              "type": "null"
            }
          ]
        },
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "turnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "search": {
          "type": [
            "string",
            "null"
          ]
        },
        "offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "locateThreadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "locateTurnId": {
          "type": [
            "string",
            "null"
          ]
