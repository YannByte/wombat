    "Sort": {
      "type": "string",
      "enum": [
        "tokens",
        "cost",
        "recent",
        "time"
      ]
    },
    "Presentation": {
      "type": "string",
      "enum": [
        "distribution",
        "details",
        "projects",
        "models"
