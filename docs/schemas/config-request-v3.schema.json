{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Request",
  "type": "object",
  "properties": {
    "review": {
      "description": "Observe native Skill metadata and order context footprint alongside use frequency.",
      "type": "boolean",
      "default": false
    },
    "action": {
      "default": "list",
      "allOf": [
        {
          "$ref": "#/definitions/Action"
        }
      ]
    },
    "roots": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "projectRoots": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "cachedUsage": {
      "description": "Check current configuration against committed usage without scheduling collection.",
      "type": "boolean",
      "default": false
    },
    "scope": {
      "default": {
        "allTime": null,
        "since": null,
        "until": null,
        "timezone": null,
        "project": null,
        "agentKind": null,
        "sourceInstanceId": null,
        "threadId": null
      },
      "allOf": [
        {
          "$ref": "#/definitions/Scope"
        }
      ]
    },
    "kind": {
      "anyOf": [
        {
          "$ref": "#/definitions/Kind"
        },
        {
          "type": "null"
        }
      ]
    },
    "kinds": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/Kind"
      }
    },
    "observation": {
      "anyOf": [
        {
          "$ref": "#/definitions/Observation"
        },
        {
          "type": "null"
        }
      ]
    },
    "search": {
      "type": [
        "string",
        "null"
      ]
    },
    "sort": {
      "default": "tokens",
      "allOf": [
        {
          "$ref": "#/definitions/Sort"
        }
      ]
    },
    "itemId": {
      "type": [
        "string",
        "null"
      ]
    },
    "offset": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unassigned": {
      "description": "Explain unresolved records rather than attributing them to every inventory item.",
      "type": "boolean",
      "default": false
    },
    "baseline": {
      "anyOf": [
        {
          "$ref": "#/definitions/UseReplayBaseline"
        },
        {
          "type": "null"
        }
      ]
    },
    "baselineRecords": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/UseTraceRecord"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Action": {
      "type": "string",
      "enum": [
        "list",
        "detail",
        "evidence",
        "explain",
        "related_scopes",
        "capabilities"
      ]
    },
    "Scope": {
      "type": "object",
      "properties": {
        "allTime": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "since": {
          "type": [
            "string",
            "null"
          ]
        },
        "until": {
          "type": [
            "string",
            "null"
          ]
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "agentKind": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceInstanceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Kind": {
      "type": "string",
      "enum": [
        "rule",
        "skill",
        "mcp",
        "hook"
      ]
    },
    "Observation": {
      "type": "string",
      "enum": [
        "used",
        "loaded_only",
        "unknown"
      ]
    },
    "Sort": {
      "type": "string",
      "enum": [
        "tokens",
        "activity",
        "size",
        "name",
        "content_tokens",
        "characters",
        "recent",
        "review",
        "context_tokens",
        "least_activity"
      ]
    },
    "UseReplayBaseline": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "methodVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "scope": {
          "$ref": "#/definitions/Scope"
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "projectRoots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/definitions/Kind"
            },
            {
              "type": "null"
            }
          ]
        },
        "itemId": {
          "type": [
            "string",
            "null"
          ]
        },
        "unassigned": {
          "type": "boolean"
        },
        "inputRevision": {
          "description": "Normalized input facts, not raw source bodies or a guarantee of native coverage.",
          "type": "string"
        },
        "configurationRevision": {
          "type": "string"
        },
        "resultRevision": {
          "type": "string"
        },
        "counted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "totalRecords": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/UseReasonCount"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "methodVersion",
        "scope",
        "roots",
        "projectRoots",
        "unassigned",
        "inputRevision",
        "configurationRevision",
        "resultRevision",
        "counted",
        "totalRecords",
        "reasons"
      ]
    },
    "UseReasonCount": {
      "type": "object",
      "properties": {
        "reason": {
          "$ref": "#/definitions/UseReason"
        },
        "records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "required": [
        "reason",
        "records"
      ]
    },
    "UseReason": {
      "type": "string",
      "enum": [
        "counted",
        "identity_missing",
        "time_missing",
        "dispatch_unknown",
        "target_missing",
        "target_not_found",
        "target_ambiguous",
        "identity_conflict",
        "duplicate",
        "outside_window",
        "outside_project",
        "catalog_only",
        "instruction_load",
        "not_use"
      ]
    },
    "UseTraceRecord": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string"
        },
        "sourceInstanceId": {
          "type": "string"
        },
        "threadId": {
          "type": "string"
        },
        "turnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "itemId": {
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "eventType": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "reason": {
          "$ref": "#/definitions/UseReason"
        },
        "countDelta": {
          "description": "None means the evidence cannot establish a numeric contribution.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/definitions/EvidenceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceObservationCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "additionalEvidence": {
          "description": "Up to three further source observations; phases are not independent uses.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/EvidenceRef"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "operationId",
        "sourceInstanceId",
        "threadId",
        "eventType",
        "outcome",
        "reason",
        "sourceObservationCount",
        "additionalEvidence"
      ]
    },
    "EvidenceRef": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "file",
        "line"
      ]
    }
  },
  "$comment": "Wombat request protocol 3"
}
