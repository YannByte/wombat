{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Request",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/definitions/Action"
    },
    "snapshotId": {
      "type": "string"
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "selection": {
      "default": {
        "since": null,
        "until": null,
        "timezone": null,
        "includeUndated": false,
        "sources": [],
        "projects": [],
        "threads": [],
        "turns": [],
        "origins": [],
        "phases": [],
        "recordKinds": []
      },
      "allOf": [
        {
          "$ref": "#/definitions/Selection"
        }
      ]
    },
    "limit": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "query": {
      "type": [
        "string",
        "null"
      ]
    },
    "baselineSnapshotId": {
      "type": [
        "string",
        "null"
      ]
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ReadTarget"
      },
      "default": []
    },
    "maxScanBytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "anchor": {
      "anyOf": [
        {
          "$ref": "#/definitions/Evidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "radius": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "additionalProperties": false,
  "required": [
    "action",
    "snapshotId"
  ],
  "definitions": {
    "Action": {
      "type": "string",
      "enum": [
        "activity",
        "locate",
        "read",
        "search",
        "changes"
      ]
    },
    "Selection": {
      "type": "object",
      "properties": {
        "since": {
          "type": [
            "string",
            "null"
          ]
        },
        "until": {
          "type": [
            "string",
            "null"
          ]
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        },
        "includeUndated": {
          "type": "boolean",
          "default": false
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "threads": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "turns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "origins": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MessageOrigin"
          },
          "default": []
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ContentPhase"
          },
          "default": []
        },
        "recordKinds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MessageRecordKind"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "MessageOrigin": {
      "description": "Source-backed provenance only; an unclassified user record is not authorization.",
      "type": "string",
      "enum": [
        "assistant_visible",
        "user_input",
        "user_unclassified",
        "injected_context",
        "reasoning",
        "inter_agent",
        "inherited",
        "compaction",
        "unknown"
      ]
    },
    "ContentPhase": {
      "type": "string",
      "enum": [
        "commentary",
        "final_answer",
        "unknown"
      ]
    },
    "MessageRecordKind": {
      "type": "string",
      "enum": [
        "legacy_snapshot",
        "response_snapshot",
        "native_snapshot",
        "delta",
        "unknown"
      ]
    },
    "ReadTarget": {
      "type": "object",
      "properties": {
        "evidence": {
          "$ref": "#/definitions/Evidence"
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "maxBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "before": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "maximum": 9007199254740991
        },
        "after": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "required": [
        "evidence"
      ]
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string"
        },
        "sourceInstanceId": {
          "type": "string"
        },
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "turnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "eventOffset": {
          "description": "Exact position in the fixed target partition, not a raw file offset.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "required": [
        "eventId",
        "sourceInstanceId",
        "eventOffset"
      ]
    }
  }
}
