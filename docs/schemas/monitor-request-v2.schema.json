{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Request",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "list"
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "plan": {
          "$ref": "#/definitions/Plan"
        },
        "action": {
          "type": "string",
          "const": "upsert"
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "plan"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "const": "remove"
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "action": {
          "type": "string",
          "const": "check"
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "ids"
      ]
    },
    {
      "type": "object",
      "properties": {
        "notificationId": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "const": "acknowledge"
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "notificationId"
      ]
    }
  ],
  "definitions": {
    "Plan": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "enabled": {
          "type": "boolean"
        },
        "period": {
          "$ref": "#/definitions/Period"
        },
        "scope": {
          "description": "Identity filters and timezone only; date, undated, thread and turn filters are rejected.",
          "default": {
            "allTime": null,
            "timezone": null,
            "since": null,
            "until": null,
            "agentKind": null,
            "sourceInstanceId": null,
            "model": null,
            "modelUnknown": null,
            "effortUnknown": null,
            "undated": null,
            "reasoningEffort": null,
            "project": null,
            "projectUnknown": null,
            "threadId": null,
            "turnId": null
          },
          "allOf": [
            {
              "$ref": "#/definitions/Scope"
            }
          ]
        },
        "tokenLimit": {
          "description": "Token budget, not an account allowance or money allocation to tools.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "warningRatio": {
          "description": "Fraction in (0,1]; 0.8 by default.",
          "type": [
            "number",
            "null"
          ]
        },
        "review": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "enabled",
        "period",
        "review"
      ]
    },
    "Period": {
      "type": "string",
      "enum": [
        "day",
        "week",
        "month"
      ]
    },
    "Scope": {
      "type": "object",
      "properties": {
        "allTime": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        },
        "since": {
          "type": [
            "string",
            "null"
          ]
        },
        "until": {
          "type": [
            "string",
            "null"
          ]
        },
        "agentKind": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceInstanceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "modelUnknown": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "effortUnknown": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "undated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reasoningEffort": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "projectUnknown": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "turnId": {
          "description": "Exact turn inspection, always bound to a selected thread.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    }
  },
  "$comment": "Wombat request protocol 2"
}
