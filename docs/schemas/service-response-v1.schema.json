{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Response",
  "type": "object",
  "properties": {
    "outputVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "action": {
      "$ref": "#/definitions/Action"
    },
    "running": {
      "type": "boolean"
    },
    "resident": {
      "type": "boolean"
    },
    "paused": {
      "type": "boolean"
    },
    "stopping": {
      "type": "boolean"
    },
    "instanceId": {
      "type": [
        "string",
        "null"
      ]
    },
    "runtime": {
      "anyOf": [
        {
          "$ref": "#/definitions/RuntimeIdentity"
        },
        {
          "type": "null"
        }
      ]
    },
    "autoStart": {
      "type": "boolean"
    },
    "controlsAvailable": {
      "type": "boolean"
    },
    "preparing": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "ready": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "checkedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "watcher": {
      "type": "string"
    },
    "parserCacheBytes": {
      "description": "Encoded parser-state cache budget; this is not a hard process RSS limit.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "parserCacheBudgetBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "outputVersion",
    "action",
    "running",
    "resident",
    "paused",
    "stopping",
    "autoStart",
    "controlsAvailable",
    "watcher",
    "parserCacheBytes",
    "parserCacheBudgetBytes"
  ],
  "definitions": {
    "Action": {
      "type": "string",
      "enum": [
        "status",
        "start",
        "pause",
        "resume",
        "stop",
        "enable",
        "disable"
      ]
    },
    "RuntimeIdentity": {
      "type": "object",
      "properties": {
        "binary": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "modifiedNs": {
          "type": "string"
        },
        "contextKey": {
          "type": "string"
        }
      },
      "required": [
        "binary",
        "bytes",
        "modifiedNs",
        "contextKey"
      ]
    }
  }
}
