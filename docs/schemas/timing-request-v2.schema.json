{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Request",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "threadId": {
          "type": "string"
        },
        "turnId": {
          "type": "string"
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/definitions/Scope"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "default": "auto",
          "allOf": [
            {
              "$ref": "#/definitions/Mode"
            }
          ]
        },
        "privacyProfile": {
          "default": "local",
          "allOf": [
            {
              "$ref": "#/definitions/PrivacyProfile"
            }
          ]
        },
        "action": {
          "type": "string",
          "const": "summary"
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "threadId",
        "turnId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "threadId": {
          "type": "string"
        },
        "turnId": {
          "type": "string"
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/definitions/Scope"
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/definitions/Cursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 50
        },
        "collection": {
          "default": "turn_events",
          "allOf": [
            {
              "$ref": "#/definitions/EvidenceSet"
            }
          ]
        },
        "objectRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "privacyProfile": {
          "default": "local",
          "allOf": [
            {
              "$ref": "#/definitions/PrivacyProfile"
            }
          ]
        },
        "action": {
          "type": "string",
          "const": "evidence"
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "threadId",
        "turnId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "privacyProfile": {
          "default": "local",
          "allOf": [
            {
              "$ref": "#/definitions/PrivacyProfile"
            }
          ]
        },
        "action": {
          "type": "string",
          "const": "capabilities"
        }
      },
      "additionalProperties": false,
      "required": [
        "action"
      ]
    }
  ],
  "definitions": {
    "Scope": {
      "type": "object",
      "properties": {
        "sourceInstanceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "agentKind": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Mode": {
      "type": "string",
      "enum": [
        "auto",
        "fresh",
        "cached"
      ]
    },
    "PrivacyProfile": {
      "type": "string",
      "enum": [
        "local",
        "share-v1"
      ]
    },
    "Cursor": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "maxLength": 8192
        }
      },
      "additionalProperties": false,
      "required": [
        "token"
      ]
    },
    "EvidenceSet": {
      "type": "string",
      "enum": [
        "turn_events",
        "use_objects",
        "use_records"
      ]
    }
  },
  "$comment": "Wombat request protocol 2"
}
