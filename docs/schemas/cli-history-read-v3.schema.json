{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HistoryRead",
  "description": "A bounded original-text read and an independent continuation for message locations.",
  "type": "object",
  "properties": {
    "outputVersion": {
      "type": "integer",
      "minimum": 3,
      "maximum": 3
    },
    "result": {
      "$ref": "#/definitions/Response"
    },
    "nextLocations": {
      "anyOf": [
        {
          "$ref": "#/definitions/Request"
        },
        {
          "type": "null"
        }
      ]
    },
    "retryRead": {
      "description": "Original read targets deferred by the response budget.",
      "anyOf": [
        {
          "$ref": "#/definitions/Request"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "outputVersion",
    "result"
  ],
  "definitions": {
    "Response": {
      "type": "object",
      "properties": {
        "record": {
          "anyOf": [
            {
              "$ref": "#/definitions/ResolvedRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "outputVersion": {
          "type": "integer",
          "minimum": 0,
          "const": 7,
          "maximum": 4294967295
        },
        "action": {
          "$ref": "#/definitions/Action"
        },
        "snapshotId": {
          "type": "string"
        },
        "selection": {
          "$ref": "#/definitions/Selection"
        },
        "roots": {
          "description": "Explicit roots used for this query, for a search-to-read handoff.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Activity"
          }
        },
        "fragments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Fragment"
          }
        },
        "neighbors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Neighbor"
          }
        },
        "sourceHits": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceHit"
          }
        },
        "sourceFiles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceSearchFile"
          }
        },
        "sourceNeighbors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceNeighbor"
          }
        },
        "nextSearch": {
          "anyOf": [
            {
              "$ref": "#/definitions/Request"
            },
            {
              "type": "null"
            }
          ]
        },
        "readIssues": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReadIssue"
          }
        },
        "sourceScope": {
          "type": [
            "string",
            "null"
          ]
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "scanComplete": {
          "description": "All matching indexed positions were visited; source completeness is separate.",
          "type": "boolean"
        },
        "partial": {
          "type": "boolean"
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scannedEvents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sourceBytesRead": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "freshness": {
          "anyOf": [
            {
              "$ref": "#/definitions/Freshness"
            },
            {
              "type": "null"
            }
          ]
        },
        "window": {
          "description": "When present, completeness applies only to this requested source window.",
          "anyOf": [
            {
              "$ref": "#/definitions/ContextWindow"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "outputVersion",
        "action",
        "snapshotId",
        "selection",
        "items",
        "fragments",
        "scanComplete",
        "partial",
        "limits",
        "scannedEvents",
        "sourceBytesRead"
      ]
    },
    "ResolvedRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "upstreamId": {
          "type": "string"
        },
        "sourceInstanceId": {
          "type": "string"
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "upstreamId",
        "sourceInstanceId"
      ]
    },
    "Action": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "activity",
            "locate",
            "read",
            "search"
          ]
        },
        {
          "description": "One source-backed activity per conversation, including work without measurements.",
          "type": "string",
          "const": "records"
        },
        {
          "description": "Resolve an exact canonical or upstream identity without scanning activity or text.",
          "type": "string",
          "const": "resolve"
        },
        {
          "description": "Search visible Codex source text and return excerpts without an index.",
          "type": "string",
          "const": "source_search"
        }
      ]
    },
    "Selection": {
      "type": "object",
      "properties": {
        "operationId": {
          "description": "One canonical operation inside an explicitly selected thread and turn.",
          "type": [
            "string",
            "null"
          ]
        },
        "includeToolOutput": {
          "description": "Read/search selected tool results on demand; bodies are never indexed.",
          "type": "boolean",
          "default": false
        },
        "since": {
          "type": [
            "string",
            "null"
          ]
        },
        "until": {
          "type": [
            "string",
            "null"
          ]
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        },
        "includeUndated": {
          "type": "boolean",
          "default": false
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "threads": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "turns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "origins": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MessageOrigin"
          },
          "default": []
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ContentPhase"
          },
          "default": []
        },
        "recordKinds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MessageRecordKind"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "MessageOrigin": {
      "description": "Source-backed provenance only; an unclassified user record is not authorization.",
      "type": "string",
      "enum": [
        "assistant_visible",
        "user_input",
        "user_unclassified",
        "injected_context",
        "reasoning",
        "inter_agent",
        "inherited",
        "compaction",
        "unknown"
      ]
    },
    "ContentPhase": {
      "type": "string",
      "enum": [
        "commentary",
        "final_answer",
        "unknown"
      ]
    },
    "MessageRecordKind": {
      "type": "string",
      "enum": [
        "legacy_snapshot",
        "response_snapshot",
        "native_snapshot",
        "delta",
        "unknown"
      ]
    },
    "Activity": {
      "type": "object",
      "properties": {
        "record": {
          "anyOf": [
            {
              "$ref": "#/definitions/RecordSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "readCursor": {
          "description": "Read-target cursor at a source search match; bound to snapshot, selection and evidence.",
          "type": [
            "string",
            "null"
          ]
        },
        "matchedTerm": {
          "description": "The literal at the returned read cursor.",
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "$ref": "#/definitions/Evidence"
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "collectedAt": {
          "type": "string"
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/definitions/MessageOrigin"
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "anyOf": [
            {
              "$ref": "#/definitions/ContentPhase"
            },
            {
              "type": "null"
            }
          ]
        },
        "nativeMessageId": {
          "type": [
            "string",
            "null"
          ]
        },
        "recordKind": {
          "anyOf": [
            {
              "$ref": "#/definitions/MessageRecordKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "operationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "hasTextLocator": {
          "type": "boolean"
        },
        "contentPartial": {
          "type": "boolean"
        },
        "change": {
          "anyOf": [
            {
              "$ref": "#/definitions/Change"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "evidence",
        "collectedAt",
        "kind",
        "hasTextLocator",
        "contentPartial"
      ]
    },
    "RecordSummary": {
      "type": "object",
      "properties": {
        "upstreamId": {
          "type": "string"
        },
        "startedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastActivityAt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "upstreamId"
      ]
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string"
        },
        "sourceInstanceId": {
          "type": "string"
        },
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "turnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "eventOffset": {
          "description": "Exact position in the fixed target partition, not a raw file offset.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "required": [
        "eventId",
        "sourceInstanceId",
        "eventOffset"
      ]
    },
    "Change": {
      "type": "string",
      "enum": [
        "new_source_file",
        "appended",
        "generation_changed"
      ]
    },
    "Fragment": {
      "type": "object",
      "properties": {
        "targetIndices": {
          "description": "Zero-based request target indices served by this occurrence.",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "evidence": {
          "$ref": "#/definitions/Evidence"
        },
        "message": {
          "$ref": "#/definitions/Activity"
        },
        "text": {
          "type": "string"
        },
        "matchRange": {
          "anyOf": [
            {
              "$ref": "#/definitions/MatchRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ContentLocation"
          }
        },
        "context": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Activity"
          }
        },
        "visibleContext": {
          "anyOf": [
            {
              "$ref": "#/definitions/VisibleContext"
            },
            {
              "type": "null"
            }
          ]
        },
        "partial": {
          "type": "boolean"
        },
        "alsoAt": {
          "description": "Other read targets whose returned text is exactly equal to this text.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/FragmentOccurrence"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "targetIndices",
        "evidence",
        "message",
        "text",
        "locations",
        "context",
        "partial"
      ]
    },
    "MatchRange": {
      "type": "object",
      "properties": {
        "start": {
          "description": "Start and exclusive end in UTF-8 bytes within the returned text.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ]
    },
    "ContentLocation": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "byteStart": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "byteEnd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "part": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "byteStart",
        "byteEnd",
        "part"
      ]
    },
    "VisibleContext": {
      "type": "object",
      "properties": {
        "before": {
          "description": "Event IDs into the response's shared neighbor bodies, in source order.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "partial": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "before",
        "after",
        "partial"
      ]
    },
    "FragmentOccurrence": {
      "type": "object",
      "properties": {
        "targetIndices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "evidence": {
          "$ref": "#/definitions/Evidence"
        },
        "message": {
          "$ref": "#/definitions/Activity"
        },
        "matchRange": {
          "anyOf": [
            {
              "$ref": "#/definitions/MatchRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ContentLocation"
          }
        },
        "context": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Activity"
          }
        },
        "visibleContext": {
          "anyOf": [
            {
              "$ref": "#/definitions/VisibleContext"
            },
            {
              "type": "null"
            }
          ]
        },
        "partial": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "targetIndices",
        "evidence",
        "message",
        "locations",
        "context",
        "partial"
      ]
    },
    "Neighbor": {
      "type": "object",
      "properties": {
        "message": {
          "$ref": "#/definitions/Activity"
        },
        "text": {
          "type": "string"
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ContentLocation"
          }
        },
        "partial": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "message",
        "text",
        "locations",
        "partial"
      ]
    },
    "SourceHit": {
      "type": "object",
      "properties": {
        "fileIndex": {
          "description": "Zero-based index into this response's source files.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "$ref": "#/definitions/MessageOrigin"
        },
        "byteStart": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "byteEnd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "description": "Digest of the complete original JSONL record.",
          "type": "string"
        },
        "matchedTerm": {
          "type": "string"
        },
        "matchRange": {
          "$ref": "#/definitions/MatchRange"
        },
        "text": {
          "type": "string"
        },
        "context": {
          "anyOf": [
            {
              "$ref": "#/definitions/SourceContext"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "fileIndex",
        "origin",
        "byteStart",
        "byteEnd",
        "sha256",
        "matchedTerm",
        "matchRange",
        "text"
      ]
    },
    "SourceContext": {
      "type": "object",
      "properties": {
        "before": {
          "description": "Indices into the response's shared source neighbors, in file order.",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "after": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "partial": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "before",
        "after",
        "partial"
      ]
    },
    "SourceSearchFile": {
      "type": "object",
      "properties": {
        "sourceInstanceId": {
          "type": "string"
        },
        "threadId": {
          "type": "string"
        },
        "upstreamId": {
          "type": "string"
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "file": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "sourceInstanceId",
        "threadId",
        "upstreamId",
        "file"
      ]
    },
    "SourceNeighbor": {
      "type": "object",
      "properties": {
        "fileIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "$ref": "#/definitions/MessageOrigin"
        },
        "byteStart": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "byteEnd": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "partial": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "fileIndex",
        "origin",
        "byteStart",
        "byteEnd",
        "sha256",
        "text",
        "partial"
      ]
    },
    "Request": {
      "type": "object",
      "properties": {
        "action": {
          "$ref": "#/definitions/Action"
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "selection": {
          "default": {
            "includeToolOutput": false,
            "since": null,
            "until": null,
            "timezone": null,
            "includeUndated": false,
            "sources": [],
            "projects": [],
            "threads": [],
            "turns": [],
            "origins": [],
            "phases": [],
            "recordKinds": []
          },
          "allOf": [
            {
              "$ref": "#/definitions/Selection"
            }
          ]
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "offset": {
          "description": "Skip matching conversations in Records; other actions use bound cursors.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "query": {
          "type": [
            "string",
            "null"
          ]
        },
        "terms": {
          "description": "Search only. Match any of 1–16 literal terms. Supply this or query.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ReadTarget"
          },
          "default": []
        },
        "maxScanBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "complete": {
          "description": "Use the extended foreground scan budget for search or location.",
          "type": "boolean"
        },
        "contextMessages": {
          "description": "Read this many visible messages on either side of each read target or direct source hit.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "excerptBytes": {
          "description": "Maximum UTF-8 bytes per direct source hit.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fixedScope": {
          "description": "Pin an evidence scan to its first observed source scope.",
          "type": "boolean"
        },
        "sourceScope": {
          "description": "Use the scope returned by the initial scan when reading export evidence.",
          "type": [
            "string",
            "null"
          ]
        },
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/definitions/Evidence"
            },
            {
              "type": "null"
            }
