{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Request",
  "type": "object",
  "properties": {
    "comparison": {
      "anyOf": [
        {
          "$ref": "#/definitions/ComparisonRequest"
        },
        {
          "type": "null"
        }
      ]
    },
    "action": {
      "$ref": "#/definitions/Action"
    },
    "roots": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "default": {
        "allTime": null,
        "timezone": null,
        "since": null,
        "until": null,
        "agentKind": null,
        "sourceInstanceId": null,
        "model": null,
        "modelUnknown": null,
        "effortUnknown": null,
        "undated": null,
        "reasoningEffort": null,
        "project": null,
        "projectUnknown": null,
        "threadId": null,
        "turnId": null
      },
      "allOf": [
        {
          "$ref": "#/definitions/Scope"
        }
      ]
    },
    "group": {
      "anyOf": [
        {
          "$ref": "#/definitions/Group"
        },
        {
          "type": "null"
        }
      ]
    },
    "sort": {
      "anyOf": [
        {
          "$ref": "#/definitions/Sort"
        },
        {
          "type": "null"
        }
      ]
    },
    "presentation": {
      "anyOf": [
        {
          "$ref": "#/definitions/Presentation"
        },
        {
          "type": "null"
        }
      ]
    },
    "threadId": {
      "type": [
        "string",
        "null"
      ]
    },
    "turnId": {
      "type": [
        "string",
        "null"
      ]
    },
    "search": {
      "type": [
        "string",
        "null"
      ]
    },
    "offset": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "locateThreadId": {
      "type": [
        "string",
        "null"
      ]
    },
    "locateTurnId": {
      "type": [
        "string",
        "null"
      ]
    },
    "locateOperationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "matchedOnly": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "compact": {
      "description": "Keep totals and the requested page, with bounded quality examples and no facets.",
      "type": [
        "boolean",
        "null"
      ],
      "default": null
    }
  },
  "additionalProperties": false,
  "required": [
    "action"
  ],
  "definitions": {
    "ComparisonRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "baselineSince": {
              "type": "string"
            },
            "baselineUntil": {
              "type": "string"
            },
            "dimension": {
              "$ref": "#/definitions/DriverDimension"
            },
            "kind": {
              "type": "string",
              "const": "periods"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "baselineSince",
            "baselineUntil",
            "dimension"
          ]
        },
        {
          "type": "object",
          "properties": {
            "leftThreadId": {
              "type": "string"
            },
            "rightThreadId": {
              "type": "string"
            },
            "includeDescendants": {
              "type": "boolean",
              "default": false
            },
            "kind": {
              "type": "string",
              "const": "sessions"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "leftThreadId",
            "rightThreadId"
          ]
        }
      ]
    },
    "DriverDimension": {
      "type": "string",
      "enum": [
        "project",
        "model",
        "thread"
      ]
    },
    "Action": {
      "type": "string",
      "enum": [
        "usage",
        "threads",
        "turns",
        "steps",
        "compare",
        "investigate",
        "trajectory",
        "resources",
        "review",
        "context",
        "statistics"
      ]
    },
    "Scope": {
      "type": "object",
      "properties": {
        "allTime": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        },
        "since": {
          "type": [
            "string",
            "null"
          ]
        },
        "until": {
          "type": [
            "string",
            "null"
          ]
        },
        "agentKind": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceInstanceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "modelUnknown": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "effortUnknown": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "undated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reasoningEffort": {
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "projectUnknown": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "turnId": {
          "description": "Exact turn inspection, always bound to a selected thread.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "Group": {
      "type": "string",
      "enum": [
        "day",
        "week",
        "month"
      ]
    },
    "Sort": {
      "type": "string",
      "enum": [
        "tokens",
        "cost",
        "recent",
        "time"
      ]
    },
    "Presentation": {
      "type": "string",
      "enum": [
        "distribution",
        "details",
        "projects",
        "models"
      ]
    }
  },
  "$comment": "Wombat request protocol 4"
}
