{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Request",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/definitions/Action"
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "selection": {
      "default": {
        "includeToolOutput": false,
        "since": null,
        "until": null,
        "timezone": null,
        "includeUndated": false,
        "sources": [],
        "projects": [],
        "threads": [],
        "turns": [],
        "origins": [],
        "phases": [],
        "recordKinds": []
      },
      "allOf": [
        {
          "$ref": "#/definitions/Selection"
        }
      ]
    },
    "limit": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "offset": {
      "description": "Skip matching conversations in Records; other actions use bound cursors.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "query": {
      "type": [
        "string",
        "null"
      ]
    },
    "terms": {
      "description": "Search only. Match any of 1–16 literal terms. Supply this or query.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ReadTarget"
      },
      "default": []
    },
    "maxScanBytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "complete": {
      "description": "Use the extended foreground scan budget for search or location.",
      "type": "boolean"
    },
    "contextMessages": {
      "description": "Read this many visible messages on either side of each read target or direct source hit.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "excerptBytes": {
      "description": "Maximum UTF-8 bytes per direct source hit.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "fixedScope": {
      "description": "Pin an evidence scan to its first observed source scope.",
      "type": "boolean"
    },
    "sourceScope": {
      "description": "Use the scope returned by the initial scan when reading export evidence.",
      "type": [
        "string",
        "null"
      ]
    },
    "anchor": {
      "anyOf": [
        {
          "$ref": "#/definitions/Evidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "radius": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "additionalProperties": false,
  "required": [
    "action"
  ],
  "definitions": {
    "Action": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "activity",
            "locate",
            "read",
            "search"
          ]
        },
        {
          "description": "One source-backed activity per conversation, including work without measurements.",
          "type": "string",
          "const": "records"
        },
        {
          "description": "Resolve an exact canonical or upstream identity without scanning activity or text.",
          "type": "string",
          "const": "resolve"
        },
        {
          "description": "Search visible Codex source text and return excerpts without an index.",
          "type": "string",
          "const": "source_search"
        }
      ]
    },
    "Selection": {
      "type": "object",
      "properties": {
        "operationId": {
          "description": "One canonical operation inside an explicitly selected thread and turn.",
          "type": [
            "string",
            "null"
          ]
        },
        "includeToolOutput": {
          "description": "Read/search selected tool results on demand; bodies are never indexed.",
          "type": "boolean",
          "default": false
        },
        "since": {
          "type": [
            "string",
            "null"
          ]
        },
        "until": {
          "type": [
            "string",
            "null"
          ]
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        },
        "includeUndated": {
          "type": "boolean",
          "default": false
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "threads": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "turns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "origins": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MessageOrigin"
          },
          "default": []
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ContentPhase"
          },
          "default": []
        },
        "recordKinds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/MessageRecordKind"
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "MessageOrigin": {
      "description": "Source-backed provenance only; an unclassified user record is not authorization.",
      "type": "string",
      "enum": [
        "assistant_visible",
        "user_input",
        "user_unclassified",
        "injected_context",
        "reasoning",
        "inter_agent",
        "inherited",
        "compaction",
        "unknown"
      ]
    },
    "ContentPhase": {
      "type": "string",
      "enum": [
        "commentary",
        "final_answer",
        "unknown"
      ]
    },
    "MessageRecordKind": {
      "type": "string",
      "enum": [
        "legacy_snapshot",
        "response_snapshot",
        "native_snapshot",
        "delta",
        "unknown"
      ]
    },
    "ReadTarget": {
      "type": "object",
      "properties": {
        "evidence": {
          "$ref": "#/definitions/Evidence"
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "maxBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "before": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "maximum": 9007199254740991
        },
        "after": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "required": [
        "evidence"
      ]
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string"
        },
        "sourceInstanceId": {
          "type": "string"
        },
        "threadId": {
          "type": [
            "string",
            "null"
          ]
        },
        "turnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "eventOffset": {
          "description": "Exact position in the fixed target partition, not a raw file offset.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "required": [
        "eventId",
        "sourceInstanceId",
        "eventOffset"
      ]
    }
  },
  "$comment": "Wombat request protocol 7"
}
