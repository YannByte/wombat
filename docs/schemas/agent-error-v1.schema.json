{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ErrorOutput",
  "type": "object",
  "properties": {
    "outputVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "error": {
      "$ref": "#/definitions/Error"
    }
  },
  "required": [
    "outputVersion",
    "error"
  ],
  "definitions": {
    "Error": {
      "type": "object",
      "properties": {
        "details": {
          "anyOf": [
            {
              "$ref": "#/definitions/InputErrorDetails"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "recovery": {
          "$ref": "#/definitions/Recovery"
        }
      },
      "required": [
        "code",
        "message",
        "recovery"
      ]
    },
    "InputErrorDetails": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InputErrorField"
          },
          "maxItems": 4
        },
        "schemaCommand": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "fields",
        "schemaCommand"
      ]
    },
    "InputErrorField": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 256
        },
        "reason": {
          "type": "string",
          "maxLength": 160
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "reason"
      ]
    },
    "Recovery": {
      "type": "string",
      "enum": [
        "read_schema",
        "narrow_query",
        "retry_same_scope",
        "check_setup",
        "inspect_state",
        "none"
      ]
    }
  }
}
